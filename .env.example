# ==============================================================================
# Turium AI Knowledge Inbox - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (SQLite local file fallback)
DATABASE_PATH=./data/knowledge_inbox.db

# ------------------------------------------------------------------------------
# Cloud Database Configuration (Turso / libSQL)
# ------------------------------------------------------------------------------
# Primary relational database URL (e.g. libsql://your-db-org.turso.io)
TURSO_DATABASE_URL=
# Turso authentication token (read strictly server-side)
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Dedicated Vector Database Configuration (Qdrant Cloud)
# ------------------------------------------------------------------------------
# Qdrant cluster endpoint URL (e.g. https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333)
QDRANT_URL=
# Qdrant API key (read strictly server-side)
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# Google Gemini Configuration
# ------------------------------------------------------------------------------
# Secret Google Gemini API Key from Google AI Studio / Gemini Developer API
# (Read exclusively server-side, never exposed to client)
GEMINI_API_KEY=

# Chat Completion Model
# Recommended and verified: gemini-3.5-flash-lite (default) or gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Embedding Model Configuration
# Official Google Gen AI embedding model supporting custom output dimensionality
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
