{
  "name": "turium-ai-knowledge-inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal AI Knowledge Inbox - Full Stack Interview Assignment for Turium AI",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm --prefix server run start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server",
    "reindex": "npm --prefix server run reindex",
    "migrate:cloud": "npm --prefix server run migrate:cloud --",
    "postinstall": "node scripts/ensure-rollup-wasm.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
