{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API service for Turium AI Knowledge Inbox",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "reindex": "tsx src/scripts/reindex.ts",
    "migrate:cloud": "tsx src/scripts/migrate-cloud.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@libsql/client": "^0.18.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ipaddr.js": "^1.9.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
